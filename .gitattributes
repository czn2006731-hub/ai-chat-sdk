# 统一换行符：仓库内一律使用 LF，避免 Windows/Linux 混用导致整文件 diff
* text=auto eol=lf

# 明确指定 C/C++ 源码与脚本
*.h    text eol=lf
*.hpp  text eol=lf
*.cpp  text eol=lf
*.cc   text eol=lf
*.c    text eol=lf
*.txt  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf
*.cmake text eol=lf

# 二进制文件不做任何转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.db   binary
*.a    binary
*.so   binary
*.exe  binary
